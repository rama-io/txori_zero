<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/root"
        style="@style/VerticalList"
        android:layout_height="match_parent"
        android:background="@color/base"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp">

        <LinearLayout style="@style/HorizontalList">

            <FrameLayout
                android:id="@+id/close_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12sp"
                android:visibility="gone">

                <ImageView
                    style="@style/Icon24"
                    android:contentDescription="@string/alt_close"
                    android:src="@drawable/px_times" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/edit_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12sp"
                android:visibility="gone">

                <ImageView
                    style="@style/Icon24"
                    android:contentDescription="@string/alt_edit"
                    android:src="@drawable/px_edit" />
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/open_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12sp">

                <ImageView
                    style="@style/Icon24"
                    android:contentDescription="@string/alt_open_settings"
                    android:src="@drawable/px_cog" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                android:id="@+id/page_home"
                layout="@layout/page_home"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/page_stopwatch"
                layout="@layout/page_stopwatch"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/page_timer"
                layout="@layout/page_timer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/page_roulette"
                layout="@layout/page_roulette"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <View style="@style/SeparatorListVertical" />

        <com.rama.txori_zero.widgets.WdNavbar
            android:id="@+id/navbar"
            style="@style/HorizontalList" />
    </LinearLayout>

    <View
        android:id="@+id/flash_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/screen_flash"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />
</FrameLayout>
